_autoapply/
# скачанное ботом видео/аудио — гигабайты
downloads/
# веса YOLO: большие, в контейнер приходят томом (см. docker-compose)
weights/

# Состояние и кеши инструментов
celerybeat-schedule*
.pytest_cache/
.ruff_cache/