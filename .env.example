# ── Обязательное ─────────────────────────────────────────────────────────────
# Токен Telegram-бота (@BotFather)
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
# Ключ LLM-провайдера (по умолчанию Google Gemini, AI Studio — бесплатный tier).
# Провайдер-агностично: можно указать Groq/OpenAI/др. через LLM_BASE_URL/LLM_MODEL.
LLM_API_KEY=REPLACE_ME

# ── Инфраструктура (дефолты — под локальный docker compose; хост-порт PG = 5433) ─
DATABASE_URL=postgresql+asyncpg://vacancy:vacancy@localhost:5433/vacancy
CELERY_BROKER_URL=amqp://vacancy:vacancy@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1
RABBITMQ_URL=amqp://vacancy:vacancy@localhost:5672/
# В docker переопредели хосты на имена сервисов: postgres/redis/rabbitmq/minio.

# ── MinIO / S3 (Dewarp) ───────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=vacancy
S3_SECRET_KEY=vacancy123
S3_BUCKET_INPUT=dewarp-input
S3_BUCKET_OUTPUT=dewarp-output
# Веса YOLO для деварпинга (в git не коммитятся)
DEWARP_WEIGHTS_PATH=weights/best_26_1024_150_x_full_fix.pt

# ── LLM (Ask / Match) ─────────────────────────────────────────────────────────
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
ASK_MAX_TOKENS=1024
ASK_REASONING_EFFORT=none          # для «думающих» моделей; "" — не передавать
ASK_DIALOG_MAX_TURNS=6             # сколько последних реплик помнить (Redis)
ASK_DIALOG_TTL=3600                # TTL сессии диалога, сек
ASK_RATE_LIMIT=10                  # запросов /ask на пользователя за окно
ASK_RATE_LIMIT_WINDOW=3600
MATCH_CANDIDATES_LIMIT=25          # кандидатов из БД в LLM (retrieve-then-rank)
MATCH_MAX_TOKENS=1024
MATCH_RATE_LIMIT=5                 # /match дороже /ask → строже
MATCH_RATE_LIMIT_WINDOW=3600
LLM_DAILY_TOKEN_BUDGET=100000      # спенд-лимит: токенов (in+out) на юзера в сутки; 0 — без лимита

# ── Общий rate-limit бота ─────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60
STACK_CACHE_TTL=3600               # TTL кэша /stack, сек

# ── Скрапер hh.ru (все опциональны, есть дефолты) ─────────────────────────────
HH_HEADLESS=1                      # 1 — без окна; 0 — видимый браузер (ручная капча)
HH_MAX_PAGES=5                     # страниц выдачи за прогон (по 100 вакансий)
HH_BATCH_SIZE=10                   # размер батча записи в БД
HH_RECYCLE_EVERY=50                # пересоздавать контекст браузера каждые N страниц
HH_MAX_RUN_SECONDS=480             # мягкий лимит прогона (< Celery task_time_limit=600)